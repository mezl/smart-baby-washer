#pragma once
// Copy to include/secrets.h (gitignored) and fill in.
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// Password for over-the-air firmware updates. Anyone who can reach the board on
// the LAN can otherwise reflash it, so this is not optional in practice.
// Must match the --auth= value passed to the espota uploader (platformio.ini)
// and the ?key= used by the HTTP /update fallback path.
#define OTA_PASSWORD  "change-me"

// Nothing in this repository should ever contain the real values above. If a
// tool needs the OTA password it reads $OTA_PASSWORD from the environment; if a
// doc needs the board's address it says baby-washer.local.
